# ==============================================================================
# ReadLater — Конфигурация окружения (Self-Hosted / Production)
# ==============================================================================

# PostgreSQL База данных
POSTGRES_USER=readlater
POSTGRES_PASSWORD=change_this_secure_password_in_production
POSTGRES_DB=readlater

# Порты сервисов для внешнего Reverse Proxy
FRONTEND_PORT=3000
BACKEND_PORT=8080

# Базовый URL API для фронтенда.
# Задан -> используется HttpItemsRepository (Go API).
# Пусто/удалено -> LocalStorageItemsRepository (standalone/offline).
VITE_API_BASE_URL=/api

# Только для локальной разработки: куда Vite проксирует запросы /api (npm run dev).
VITE_API_PROXY_TARGET=http://127.0.0.1:8080

# Простая защита входа: единый пароль для приложения.
# Задан -> при открытии сайта показывается экран ввода пароля.
# Пусто -> защита выключена (по умолчанию).
APP_PASSWORD=

# AI Studio runtime variables
GEMINI_API_KEY="MY_GEMINI_API_KEY"
APP_URL="MY_APP_URL"
